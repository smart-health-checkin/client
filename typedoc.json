{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/ui/index.ts",
    "src/react/index.ts",
    "src/picker/index.ts",
    "src/wallet/index.ts",
    "src/handoff/index.ts",
    "src/fhir/index.ts",
    "src/testing/index.ts",
    "src/model/index.ts",
    "src/wire/index.ts"
  ],
  "out": "docs/api",
  "name": "@smart-health-checkin/client API",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "hidePageHeader": true,
  "hideBreadcrumbs": false,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "indexFormat": "table",
  "outputFileStrategy": "modules",
  "entryFileName": "index.md",
  "mergeReadme": false,
  "gitRevision": "main"
}
